  "query": "\n        WITH t AS (\n            UPDATE api_tokens SET last_used_at = now()\n            WHERE token_hash = $1\n            RETURNING user_id\n        )\n        SELECT u.id, u.username, u.is_admin, u.created_at\n        FROM t JOIN users u ON u.id = t.user_id\n        ",
