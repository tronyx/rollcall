{
  "db_name": "PostgreSQL",
  "query": "\n        WITH s AS (\n            UPDATE sessions SET expires_at = $2\n            WHERE token_hash = $1 AND expires_at > now()\n            RETURNING user_id\n        )\n        SELECT u.id, u.username, u.is_admin, u.created_at\n        FROM s JOIN users u ON u.id = s.user_id\n        ",
