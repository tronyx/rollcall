  "query": "\n        SELECT ps.grams, ps.status AS \"status: PrintSlotStatus\", p.name AS print_name,\n               ps.weight_event_id\n        FROM print_slots ps JOIN prints p ON p.id = ps.print_id\n        WHERE ps.print_id = $1 AND ps.slot = $2\n        ",
