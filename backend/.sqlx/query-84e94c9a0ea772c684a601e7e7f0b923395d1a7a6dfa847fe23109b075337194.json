  "query": "\n        SELECT s.id, s.status AS \"status: SpoolStatus\"\n        FROM slicer_profiles sp\n        JOIN spools s ON s.filament_id = sp.filament_id\n        WHERE sp.name = $1 AND s.status IN ('active', 'drying', 'sealed')\n        ",
