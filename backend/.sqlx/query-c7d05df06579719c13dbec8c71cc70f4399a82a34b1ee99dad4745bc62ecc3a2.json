  "query": "\n        SELECT id, spool_id, filament_id, equipment_id, content_type, size_bytes,\n               original_name, caption, created_at,\n               '/api/photos/' || id || '/file' AS \"url!\"\n        FROM photos\n        WHERE spool_id = $1 OR filament_id = $2 OR equipment_id = $3\n        ORDER BY created_at, id\n        ",
