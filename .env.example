# Copy to backend/.env for `cargo run` (the backend loads it with dotenvy).
DATABASE_URL=postgres://rollcall:rollcall@localhost:5432/rollcall
BIND_ADDR=0.0.0.0:8080
# Serve the built frontend from the backend (optional in development).
# STATIC_DIR=../frontend/build
# Allow the Vite dev server if you call the API cross-origin (the dev proxy makes this unnecessary).
# CORS_ORIGIN=http://localhost:5173
RUST_LOG=rollcall=debug,tower_http=info

# URL parser
# SCRAPER_TIMEOUT_SECS=12
# SCRAPER_USER_AGENT=...
# Set to true only if you need to parse pages on your own network.
# SCRAPER_ALLOW_PRIVATE_HOSTS=false

# Optional LLM-assisted extraction for pages the parser can't read fully.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
